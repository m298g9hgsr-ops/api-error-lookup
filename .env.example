# 環境變數範本 — 複製為 .env.local 並填入真實值
# 生產環境請在 Vercel Dashboard 設定環境變數

# ============================================
# 應用基本設定
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars  # 生產: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000                # 生產: https://your-domain.vercel.app

# ============================================
# 認證提供者 (OAuth)
# ============================================
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ============================================
# Ollama AI (本地開發)
# 生產環境建議使用雲端 GPU 或移除此依賴
# ============================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-coder
DEFAULT_AI_MODEL=deepseek-coder:6.7b

# ============================================
# Stripe 支付
# 測試模式: sk_test_... / pk_test_...
# 生產模式: sk_live_... / pk_live_...
# ============================================
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME            # stripe listen 取得
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_PRICE_ID_FREE=price_REPLACE_ME
STRIPE_PRICE_ID_PRO=price_REPLACE_ME
STRIPE_PRICE_ID_ENTERPRISE=price_REPLACE_ME

# ============================================
# 資料庫
# 開發: SQLite (file:./dev.db)
# 生產: PostgreSQL (Vercel Postgres / Neon / Supabase)
# 格式: postgresql://user:pass@host:5432/db?sslmode=require
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# 郵件服務
# ============================================
RESEND_API_KEY=

# ============================================
# 監控/分析 (可選)
# ============================================
SENTRY_DSN=
POSTHOG_KEY=

# ============================================
# Upstash Redis (速率限制用)
# 免費方案: https://upstash.com
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# 功能開關
# ============================================
ENABLE_ANALYTICS=true
ENABLE_ERROR_PATTERNS=true
ENABLE_EXPERIMENTS=false