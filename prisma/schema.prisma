generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  role          String    @default("USER")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String?
  errorInput      String  
  stackTrace      String? 
  context         String? 
  model           String   @default("deepseek-coder")
  errorType       String
  analysis        String  
  suggestions     String  
  documentation   String? 
  confidence      Float
  tokensUsed      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([createdAt])
}

model Plan {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?
  priceMonthly         Int
  priceYearly          Int?
  maxRequestsPerDay    Int
  features             String
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  subscriptions        Subscription[]
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String
  planId                 String
  stripeCustomerId       String?
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  status                 String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  canceledAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  keyHash   String   @unique
  name      String
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorPattern {
  id          String   @id @default(cuid())
  pattern     String   @unique
  errorType   String
  language    String?
  framework   String?
  rootCause   String
  fixTemplate String
  docLinks    String   // JSON string: string[]
  tags        String   // JSON string: string[]
  frequency   Int      @default(0)
  confidence  Float    @default(0.8)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([errorType])
  @@index([language])
  @@index([framework])
}

model ExperimentRun {
  id            String   @id @default(cuid())
  promptVersion String
  testCase      String
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  latencyMs     Int
  model         String
  errorInput    String
  aiResponse    String
  qualityScore  Float?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([promptVersion])
  @@index([testCase])
}

model ExperimentSummary {
  id              String   @id @default(cuid())
  promptVersion   String   @unique
  totalRuns       Int      @default(0)
  avgInputTokens  Float
  avgOutputTokens Float
  avgTotalTokens  Float
  avgLatencyMs    Float
  avgQualityScore Float?
  lastRunAt       DateTime
  updatedAt       DateTime @updatedAt
}

model QuotaUsage {
  id        String   @id @default(cuid())
  userId    String
  windowStart DateTime
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@unique([userId, windowStart])
  @@index([resetAt])
}
